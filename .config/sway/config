# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Torus 16px

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Workspace names
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7

# Locker
set $locker swaylock-fancy

# Terminal emulator
set $term ghostty 

# Application launcher
set $menu j4-dmenu-desktop --dmenu='bemenu -iwbn -p "Run:" --fn "SF Pro Text Regular 10" --tb="#222222" --tf="#cb4b16" --hb="#222222" --hf="#cb4b16" --nb="#111111"  ' --term='xfce4-terminal'

# File manager
set $filer thunar 

# Browser
set $browser firefox

# For gtk applications settings
set $gnomeschema org.gnome.desktop.interface

### Settings ###

# Monitors

# Font
font pango: SF Pro Text 10

# Borders
default_border pixel 2
# default_floating_border pixel 2
hide_edge_borders none
smart_borders on
smart_gaps on
gaps inner 2

output * bg "$HOME/Pictures/8bit_creation.png" fill

# Swap Caps Lock and Ctrl
input * {
  xkb_options grp:caps:swapcaps
}


